---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Intro from '../../components/Intro.astro';
import Weather from '../../components/Weather.astro';
import Transport from '../../components/Transport.astro';
import PracticalInfo from '../../components/PracticalInfo.astro';
import InfoSection from '../../components/InfoSection.astro';
import Heritage from '../../components/Heritage.astro';
import FeaturedQuotes from '../../components/FeaturedQuotes.astro';
import VisitGuide from '../../components/VisitGuide.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import FAQ from '../../components/FAQ.astro';
import { getI18n, languagesList } from '../../i18n/ui';
import { attraction } from '../../config';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { messages } = getI18n(Astro.url);
---

<BaseLayout
  title={messages.meta.title}
  description={messages.meta.description}
  path=""
  heroImage={attraction.heroImageWebp}
>
  <Hero />
  <Breadcrumb />
  <KeyFacts />
  <Intro />
  <Weather />
  <Transport />
  <PracticalInfo />
  <InfoSection />
  <Heritage />
  <FeaturedQuotes />
  <VisitGuide />
  <Gallery />
  <Reviews />
  <MapEmbed />
  <SourcesSection />
  <FAQ />
</BaseLayout>
