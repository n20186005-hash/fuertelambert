---
import { getI18n } from '../i18n/ui';
import { attraction } from '../config';
const { messages } = getI18n(Astro.url);
const m = messages.mapSection;
const k = messages.keyFacts;
const embedUrl = attraction.mapsEmbedSrc;
const fullAddress = `${attraction.fullName} — ${attraction.streetAddress}, ${attraction.city}, ${attraction.state}, ${attraction.country}`;
---

<section id="map" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{m.title}</h2>
    <p class="text-center text-base sm:text-lg mb-8" style="color: var(--text-secondary);">{m.subtitle}</p>

    <div class="map-container overflow-hidden border" style="border-color: var(--map-border);">
      <iframe
        src={embedUrl}
        class="w-full h-[320px] sm:h-[420px]"
        width="100%"
        height="420"
        style="border:0;"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        title={`${attraction.fullName} — ${attraction.city}, ${attraction.country}`}
      ></iframe>
    </div>

    <div class="text-center text-xs sm:text-sm mt-4 space-y-1" style="color: var(--text-muted);">
      <p>{fullAddress}</p>
      <p>
        <span>{k.coordsLabel}:</span>{' '}
        <span class="font-mono" style="color: var(--text-secondary);">
          {attraction.plusCode} · {attraction.latitude}, {attraction.longitude}
        </span>
      </p>
    </div>

    <div class="text-center mt-8">
      <a href={m.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
        📍 {m.openMaps}
      </a>
    </div>

    <p class="text-center text-sm leading-relaxed mt-6" style="color: var(--text-secondary);">
      {m.officialText}{' '}
      <a href={attraction.govtTourismUrl} target="_blank" rel="noopener noreferrer" style="color: var(--accent);">
        {m.officialLink}
      </a>.
    </p>
  </div>
</section>
